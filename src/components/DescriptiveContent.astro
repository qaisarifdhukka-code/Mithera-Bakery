---
interface Props {
  data?: {
    title?: string;
    content?: string;
  };
  title?: string;
  content?: string;
}

const { data, title, content } = Astro.props;
const displayContent = content || data?.content;
const displayTitle = title || data?.title;
---

{displayContent && (
  <section class="py-12 lg:py-16 bg-cream">
    <div class="container max-w-4xl px-4 mx-auto text-center reveal">
      {displayTitle && (
        <h2 class="font-heading text-[26px] lg:text-[34px] font-medium text-brand-dark mb-4 leading-tight">
          {displayTitle}
        </h2>
      )}
      <p class="font-body text-[15px] lg:text-[16px] text-text-secondary leading-[1.8] max-w-3xl mx-auto whitespace-pre-line">
        {displayContent}
      </p>
    </div>
  </section>
)}
