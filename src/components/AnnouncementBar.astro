---
import { Truck, Sparkles, Utensils, MapPin, Award } from 'lucide-react';
---

<div class="bg-[#3A241A] text-cream-off h-6 md:h-8 flex items-center sticky top-0 z-[1001]">
  <div class="container w-full flex justify-center md:justify-between items-center">
    
    {/* Left: Delivery Message (Visible on all screens, centered on mobile) */}
    <div class="flex items-center gap-1.5 md:flex-1 justify-center md:justify-start">
      <Truck className="w-[10px] h-[10px] md:w-3 md:h-3 text-cream-off/85" />
      <span class="text-[9px] md:text-[11px] font-medium tracking-[0.4px] md:tracking-[0.1px] text-cream-off/90">
        Free delivery on orders above ₹500
      </span>
    </div>

    {/* Center: Features (Hidden on mobile) */}
    <div class="hidden md:flex items-center gap-3.5 justify-center flex-[2]">
      <div class="flex items-center gap-1.5">
        <Sparkles className="w-3 h-3 text-cream-off/85" />
        <span class="text-[11px] font-medium tracking-[0.1px] text-cream-off/90">Pure Ingredients</span>
      </div>
      <div class="w-[1px] h-[10px] bg-cream-off/20"></div>
      <div class="flex items-center gap-1.5">
        <Utensils className="w-3 h-3 text-cream-off/85" />
        <span class="text-[11px] font-medium tracking-[0.1px] text-cream-off/90">Freshly Prepared</span>
      </div>
      <div class="w-[1px] h-[10px] bg-cream-off/20"></div>
      <div class="flex items-center gap-1.5">
        <Award className="w-3 h-3 text-cream-off/85" />
        <span class="text-[11px] font-medium tracking-[0.1px] text-cream-off/90">Premium Quality</span>
      </div>
    </div>

    {/* Right: Location (Hidden on mobile) */}
    <div class="hidden md:flex items-center gap-1.5 justify-end flex-1">
      <span class="text-[11px] font-medium tracking-[0.1px] text-cream-off/90">Mumbai, India</span>
      <MapPin className="w-3 h-3 text-cream-off/85" />
    </div>

  </div>
</div>
