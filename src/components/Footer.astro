---
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
import SubscribeForm from './react/SubscribeForm';
---

<footer id="footer" class="bg-cream text-brand-dark pt-5">
  <div class="container">
    <div class="grid grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.5fr_2fr] gap-6 pb-[30px] border-b border-brand-dark/15">
      
      {/* Brand Column */}
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-3" aria-label="Mithera Home">
          <img src="/images/LOGO.png" alt="Mithera Logo" class="w-[120px] h-auto block" />
        </a>
        <p class="text-[10px] leading-relaxed mb-4 text-text-secondary max-w-[220px]">
          Traditional Flavours, Modern Craftsmanship. Bringing sweetness to your everyday moments.
        </p>
        <div class="flex gap-2">
          <a href="https://www.facebook.com/share/1EBFHkCLUN/" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.instagram.com/mitherasweet" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="https://wa.me/919930309063" target="_blank" rel="noopener noreferrer" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          </a>
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Quick Links</h4>
        <ul class="list-none p-0 m-0">
          <li class="mb-2.5"><a href="/" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Home</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Shop</a></li>
          <li class="mb-2.5"><a href="/products" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">3D Collection</a></li>
          <li class="mb-2.5"><a href="/story" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Our Story</a></li>
          <li class="mb-2.5"><a href="/gifting" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Corporate Gifting</a></li>
          <li class="mb-2.5"><a href="/contact" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Contact</a></li>
        </ul>
      </div>

      {/* Categories */}
      <div>
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Categories</h4>
        <ul class="list-none p-0 m-0">
          <li class="mb-2.5"><a href="/shop?category=Indian+Sweets" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Indian Sweets</a></li>
          <li class="mb-2.5"><a href="/shop?category=Mithai+Boxes" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Mithai Boxes</a></li>
          <li class="mb-2.5"><a href="/shop?category=Bakery+Items" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Bakery Items</a></li>
          <li class="mb-2.5"><a href="/shop?category=Cookies+%26+Biscuits" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Cookies & Biscuits</a></li>
          <li class="mb-2.5"><a href="/shop?category=Puffs+%26+Savouries" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Puffs & Savouries</a></li>
          <li class="mb-2.5"><a href="/shop?category=Gift+Hampers" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Gift Hampers</a></li>
        </ul>
      </div>

      {/* Contact Details */}
      <div>
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Visit & Order</h4>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary leading-snug">
          <MapPin className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <span>Shop No. 13 & 14, B Wing, Pooja Enclave, Old Link Rd, Opp. Ganesh Nagar, Near Atharva College, Kandivali West, Mumbai 400067</span>
        </div>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <Phone className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <a href="tel:9930309063" class="hover:text-brand-dark text-text-secondary">+91 99303 09063</a>
        </div>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <Mail className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <a href="mailto:mitherasweets@gmail.com" class="hover:text-brand-dark text-text-secondary">mitherasweets@gmail.com</a>
        </div>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <Clock className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <span>Mon – Sun: 9:00 AM – 12:00 AM</span>
        </div>
      </div>

      {/* Subscribe */}
      <div class="col-span-2 lg:col-span-1">
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Newsletter</h4>
        <p class="text-[11px] text-text-secondary mb-4 max-w-[200px]">
          Join for festive gift catalogs and seasonal specials.
        </p>
        <SubscribeForm client:load />
      </div>
    </div>

    {/* Footer Bottom */}
    <div class="pt-6 pb-24 md:py-6 flex flex-col md:flex-row justify-between items-start md:items-center text-[11px] text-text-secondary gap-3.5 md:gap-4">
      
      {/* 4 Legal Policy Links (Mobile Top, Desktop Center) */}
      <div class="w-full md:w-auto order-1 md:order-2 pb-3.5 border-b border-brand-dark/10 md:border-b-0 md:pb-0">
        {/* Mobile: Clean 2-column balanced grid with perfect alignment */}
        <div class="grid grid-cols-2 gap-x-6 gap-y-2 md:hidden text-[11px]">
          <a href="/privacy-policy" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Privacy Policy</a>
          <a href="/terms-and-conditions" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Terms & Conditions</a>
          <a href="/cancellation-and-refund-policy" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Cancellation & Refund</a>
          <a href="/shipping-policy" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Shipping Policy</a>
        </div>
        {/* Desktop: Seamless horizontal row with bullet dividers */}
        <div class="hidden md:flex items-center gap-3 lg:gap-4 text-[11px]">
          <a href="/privacy-policy" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Privacy Policy</a>
          <span class="text-brand-dark/20">•</span>
          <a href="/terms-and-conditions" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Terms & Conditions</a>
          <span class="text-brand-dark/20">•</span>
          <a href="/cancellation-and-refund-policy" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Cancellation & Refund</a>
          <span class="text-brand-dark/20">•</span>
          <a href="/shipping-policy" class="text-text-secondary hover:text-brand-dark transition-colors no-underline">Shipping Policy</a>
        </div>
      </div>

      {/* Copyright (Mobile Middle, Desktop Left) */}
      <p class="m-0 shrink-0 text-text-secondary order-2 md:order-1 text-[11px]">
        © 2026 Mithera Sweets & Bakery. All Rights Reserved.
      </p>

      {/* Powered by Digitelixx (Mobile Bottom, Desktop Right) */}
      <a href="https://digitelixx.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 no-underline transition-opacity hover:opacity-80 shrink-0 order-3 text-[11px]">
        <span class="text-text-secondary">Powered by Digitelixx</span>
        <img src="/images/Best Digital Marketing Company in Mumbai.png" alt="Digitelixx" class="h-3 sm:h-3.5 w-auto object-contain opacity-90" />
      </a>

    </div>
  </div>
</footer>
