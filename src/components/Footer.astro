---
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
import SubscribeForm from './react/SubscribeForm';
---

<footer id="footer" class="bg-cream text-brand-dark pt-5">
  <div class="container">
    <div class="grid grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1.5fr_2fr] gap-6 pb-[30px] border-b border-brand-dark/15">
      
      {/* Brand Column */}
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-3" aria-label="Mithera Home">
          <img src="/images/LOGO.png" alt="Mithera Logo" class="w-[120px] h-auto block" />
        </a>
        <p class="text-[10px] leading-relaxed mb-4 text-text-secondary max-w-[220px]">
          Traditional Flavours, Modern Craftsmanship. Bringing sweetness to your everyday moments.
        </p>
        <div class="flex gap-2">
          <a href="#" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="YouTube">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43zM9.75 15.02V8.48l5.75 3.27-5.75 3.27z"/></svg>
          </a>
          <a href="#" class="w-7 h-7 rounded-full border border-brand-dark/20 flex items-center justify-center text-brand-dark transition-all bg-cream hover:bg-brand-dark hover:border-brand-dark hover:text-cream" aria-label="Pinterest">
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.15 9.42 7.6 11.18-.1-.94-.2-2.4.04-3.43.22-.94 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.66.97-2.9 2.17-2.9 1.02 0 1.52.77 1.52 1.7 0 1.03-.66 2.57-1 4-.28 1.2.6 2.17 1.78 2.17 2.13 0 3.77-2.25 3.77-5.5 0-2.87-2.06-4.88-5.01-4.88-3.41 0-5.42 2.56-5.42 5.2 0 1.03.4 2.13.89 2.73.1.12.11.22.08.34-.09.37-.3 1.2-.34 1.36-.06.24-.18.29-.42.17-1.57-.73-2.55-3.02-2.55-4.86 0-3.96 2.88-7.6 8.3-7.6 4.36 0 7.74 3.1 7.74 7.25 0 4.33-2.73 7.82-6.52 7.82-1.27 0-2.47-.66-2.88-1.44l-.78 2.99c-.28 1.1-1.05 2.47-1.56 3.31C9.57 23.8 10.74 24 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/></svg>
          </a>
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Quick Links</h4>
        <ul class="list-none p-0 m-0">
          <li class="mb-2.5"><a href="/" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Home</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Shop</a></li>
          <li class="mb-2.5"><a href="/products" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Products</a></li>
          <li class="mb-2.5"><a href="/story" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Our Story</a></li>
          <li class="mb-2.5"><a href="/gifting" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Gifting</a></li>
          <li class="mb-2.5"><a href="/contact" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Contact</a></li>
        </ul>
      </div>

      {/* Categories */}
      <div>
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Categories</h4>
        <ul class="list-none p-0 m-0">
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Indian Sweets</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Mithai Boxes</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Bakery Items</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Cookies & Biscuits</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Puffs & Savouries</a></li>
          <li class="mb-2.5"><a href="/shop" class="text-[11px] text-text-secondary no-underline transition-colors hover:text-brand-dark">Gift Hampers</a></li>
        </ul>
      </div>

      {/* Contact */}
      <div>
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Contact</h4>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <MapPin className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <span>123 Baker Street,<br/>Andheri West, Mumbai</span>
        </div>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <Phone className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <span>+91 98765 43210</span>
        </div>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <Mail className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <span>hello@mithera.in</span>
        </div>
        <div class="flex items-start gap-2 mb-3 text-[11px] text-text-secondary">
          <Clock className="w-3.5 h-3.5 shrink-0 mt-[1px] text-brand-warm" />
          <span>Mon – Sun: 8am – 10pm</span>
        </div>
      </div>

      {/* Subscribe */}
      <div class="col-span-2 lg:col-span-1">
        <h4 class="font-body text-[11px] font-semibold text-brand-dark mb-4">Subscribe</h4>
        <p class="text-[11px] text-text-secondary mb-4 max-w-[200px]">
          Get updates on new products, offers and more.
        </p>
        <SubscribeForm client:load />
      </div>
    </div>

    {/* Footer Bottom */}
    <div class="py-4 flex flex-row flex-nowrap justify-between items-center text-[7px] min-[375px]:text-[8px] sm:text-[10px] text-text-secondary gap-1 sm:gap-4 text-center md:text-left overflow-x-auto whitespace-nowrap hide-scrollbar">
      
      <p class="text-left m-0">© 2024 Mithera.</p>

      <div class="flex justify-center gap-2 sm:gap-4 mx-2">
        <a href="#" class="text-text-secondary no-underline hover:text-brand-dark transition-colors">Privacy Policy</a>
        <a href="#" class="text-text-secondary no-underline hover:text-brand-dark transition-colors">Terms & Conditions</a>
      </div>
      
      <a href="https://digitelixx.com/" target="_blank" rel="noopener noreferrer" class="flex justify-end items-center gap-1 no-underline transition-opacity hover:opacity-80">
        <span class="text-text-secondary">Powered by digitelixx</span>
        <img src="/images/Best Digital Marketing Company in Mumbai.png" alt="Digitelixx" class="h-2.5 sm:h-4 w-auto object-contain opacity-90" />
      </a>

    </div>
  </div>
</footer>
