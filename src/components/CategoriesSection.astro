---
import { ArrowRight } from 'lucide-react';

const categories = [
  { name: 'Indian Sweets', link: '/shop?category=Indian+Sweets', image: '/images/1 (6).png' },
  { name: 'Mithai Boxes', link: '/shop?category=Indian+Sweets', image: '/images/1 (1).png' },
  { name: 'Bakery Items', link: '/shop?category=Bakery+Items', image: '/images/1 (5).png' },
  { name: 'Cookies & Biscuits', link: '/shop?category=Cookies+%26+Biscuits', image: '/images/1 (4).png' },
  { name: 'Puffs & Savouries', link: '/shop?category=Bakery+Items', image: '/images/1 (3).png' },
  { name: 'Gift Hampers', link: '/shop?category=Gift+Hampers', image: '/images/1 (2).png' },
];
---

<section id="categories" class="py-[30px] lg:py-[35px] bg-cream">
  <div class="container">
    <div class="flex flex-col md:flex-row md:justify-between items-start md:items-end mb-[20px] gap-3 md:gap-0 reveal">
      <div>
        <p class="font-body text-[11px] font-semibold tracking-[1.8px] text-brand-warm uppercase mb-2">Explore Our Range</p>
        <h2 class="font-heading text-[32px] lg:text-[42px] font-medium text-brand-dark leading-none mb-0">Shop by Category</h2>
      </div>
      <a href="/shop" class="inline-flex items-center gap-1 text-[12px] lg:text-[13px] font-medium text-brand-dark transition-opacity hover:opacity-70 pb-1">
        View All Categories <ArrowRight className="w-3 h-3 lg:w-[14px] lg:h-[14px]" strokeWidth={2} />
      </a>
    </div>

    <div class="grid grid-cols-3 lg:grid-cols-6 gap-2 lg:gap-[18px]">
      {categories.map((category, index) => (
        <a 
          href={category.link} 
          class={`group flex flex-col bg-white rounded-[8px] overflow-hidden text-center h-[170px] lg:h-[260px] border border-brand-warm/10 shadow-[0_2px_6px_rgba(58,36,26,0.04)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_16px_rgba(58,36,26,0.08)] reveal reveal-delay-${(index % 6) + 1}`}
        >
          <div class="w-full h-[110px] lg:h-[175px] shrink-0 bg-cream overflow-hidden">
            <img 
              src={category.image} 
              alt={category.name} 
              class="w-full h-full object-cover transition-transform duration-400 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="grow flex flex-col justify-center px-1 lg:px-3">
            <h3 class="font-body text-[11px] lg:text-[14px] font-semibold text-brand-dark mb-0.5 lg:mb-1 leading-tight">{category.name}</h3>
            <span class="inline-flex items-center justify-center gap-1 font-body text-[9px] lg:text-[11px] font-medium text-brand-warm transition-colors group-hover:text-brand-dark">
              Shop Now <ArrowRight className="w-2.5 h-2.5 lg:w-3 lg:h-3" strokeWidth={2} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
