---
import { ArrowRight } from 'lucide-react';
---

<style>
  .cta-mask-left {
    -webkit-mask-image: linear-gradient(to left, transparent 0%, transparent 20%, black 75%);
    mask-image: linear-gradient(to left, transparent 0%, transparent 20%, black 75%);
  }
  .cta-mask-right {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 20%, black 75%);
    mask-image: linear-gradient(to right, transparent 0%, transparent 20%, black 75%);
  }
</style>

<section id="cta-banner" class="w-full bg-cream px-4 lg:px-[40px] pt-[20px] pb-[40px]">
  <div class="max-w-[1200px] mx-auto bg-[#EDE2D3] rounded-[8px] overflow-hidden h-[80px] lg:h-[180px] flex items-center justify-center relative text-center reveal">
    
    <img 
      src="/images/products/Kaju katli.png" 
      alt="Sweets" 
      class="absolute left-0 top-0 w-[50%] h-full object-cover z-0 cta-mask-left" 
      loading="lazy"
    />
    
    <img 
      src="/images/products/Malai barfi.png" 
      alt="Bakery" 
      class="absolute right-0 top-0 w-[50%] h-full object-cover z-0 cta-mask-right" 
      loading="lazy"
    />

    <div class="relative z-10 flex flex-col items-center px-4 w-full">
      <h2 class="font-heading text-[12px] sm:text-[20px] lg:text-[32px] font-medium text-brand-dark mb-0.5 lg:mb-2 leading-tight">Make Every Occasion Sweeter</h2>
      <p class="font-body text-[7px] sm:text-[10px] lg:text-[12px] text-text-secondary leading-[1.3] lg:leading-[1.5] max-w-[180px] sm:max-w-[280px] lg:max-w-[440px] mb-1.5 lg:mb-[18px]">Custom sweet boxes, bakery platters and gift hampers made just for you.</p>
      <a href="/shop" class="inline-flex items-center justify-center w-[65px] lg:w-[120px] h-[20px] lg:h-[36px] bg-brand-dark text-cream text-[7px] lg:text-[12px] font-medium rounded-[3px] lg:rounded-[4px] transition-colors hover:bg-brand-hover">
        Order Now <ArrowRight className="ml-[2px] w-2 h-2 lg:w-3 lg:h-3" strokeWidth={2} />
      </a>
    </div>

  </div>
</section>
