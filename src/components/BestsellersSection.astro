---
import { ArrowRight, Star } from 'lucide-react';

import AddToCartButton from './react/AddToCartButton';
import WishlistButton from './react/WishlistButton';
import { sanityClient, urlFor } from '../lib/sanity';

const { data } = Astro.props;

const rawProducts = await sanityClient.fetch(`
  *[_type == "product"] | order(isBestseller desc, name asc)[0...10] {
    _id, "slug": slug.current, name, price, rating, reviews, image, isBestseller
  }
`);
const products = rawProducts.map((p: any, i: number) => ({
  id: i + 1,
  slug: p.slug,
  name: p.name,
  price: p.price,
  rating: p.rating,
  reviews: p.reviews,
  image: urlFor(p.image),
}));
---

<section id="bestsellers" class="py-[30px] lg:py-[35px] bg-cream">
  <div class="container">
    <div class="flex flex-col md:flex-row md:justify-between items-start md:items-end mb-[18px] gap-3 md:gap-0 reveal">
      <div>
        <p class="font-body text-[11px] font-semibold tracking-[1.8px] text-brand-warm uppercase mb-2">{data?.tagline || 'OUR BESTSELLERS'}</p>
        <h2 class="font-heading text-[32px] lg:text-[42px] font-medium text-brand-dark leading-none mb-0">{data?.title || 'Popular Treats'}</h2>
      </div>
      <a href={data?.linkUrl || "/shop"} class="inline-flex items-center gap-1 text-[12px] lg:text-[13px] font-medium text-brand-dark transition-opacity hover:opacity-70 pb-1">
        {data?.linkText || 'View All Products'} <ArrowRight className="w-3 h-3 lg:w-[14px] lg:h-[14px]" strokeWidth={2} />
      </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 lg:gap-[16px]">
      {products.map((product, index) => (
        <a 
          href={`/product/${product.slug}`}
          class={`no-underline group flex flex-col bg-white rounded-[8px] overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-[0_2px_6px_rgba(58,36,26,0.04)] hover:shadow-[0_8px_16px_rgba(58,36,26,0.08)] border border-brand-warm/10 h-full reveal reveal-delay-${(index % 6) + 1} ${index >= 4 ? 'hidden lg:block' : ''}`}
        >
          <div class="w-full h-[110px] lg:h-[160px] relative bg-cream shrink-0 overflow-hidden">
            <WishlistButton client:load productId={product.id} />
            <img 
              src={product.image} 
              alt={product.name} 
              class="w-full h-full object-cover transition-transform duration-400 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col p-2 lg:p-[12px] grow">
            <h3 class="font-body text-[11px] lg:text-[13px] font-semibold text-brand-dark mb-1 leading-tight">{product.name}</h3>
            <p class="font-body text-[11px] lg:text-[13px] font-semibold text-brand-dark mb-1.5 lg:mb-2">{product.price}</p>
            {product.rating && (
              <div class="flex items-center gap-1 mb-auto pb-2">
                <Star className="w-[10px] h-[10px] lg:w-[12px] lg:h-[12px] text-brand-gold fill-brand-gold" strokeWidth={1} />
                <span class="font-body text-[9px] lg:text-[11px] font-medium text-text-secondary">{product.rating}</span>
                {product.reviews && <span class="font-body text-[9px] lg:text-[11px] font-medium text-text-secondary">({product.reviews})</span>}
              </div>
            )}
            <AddToCartButton client:load product={product} />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
