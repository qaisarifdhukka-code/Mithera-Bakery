---
import { sanityClient, urlFor } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import WishlistGrid from '../components/react/WishlistGrid';

const rawProducts = await sanityClient.fetch(`
  *[_type == "product"] { _id, "slug": slug.current, name, price, rating, reviews, image, category }
`);
const allProducts = rawProducts.map((p: any, i: number) => ({
  id: i + 1,
  slug: p.slug,
  name: p.name,
  price: p.price,
  rating: p.rating,
  reviews: p.reviews,
  image: urlFor(p.image),
  category: p.category,
}));
---

<BaseLayout title="My Wishlist | Mithera Bakery & Patisserie">
  <main class="min-h-screen bg-cream py-12 lg:py-20">
    <div class="container max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="font-heading text-[36px] lg:text-[48px] font-medium text-brand-dark mb-4">My Wishlist</h1>
        <p class="font-body text-text-secondary">Your curated collection of favorite treats.</p>
      </div>

      <WishlistGrid client:only="react" products={allProducts} />
    </div>
  </main>
  
  <Footer />
</BaseLayout>
