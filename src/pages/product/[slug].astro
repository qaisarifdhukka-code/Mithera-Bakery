---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { allProducts } from '../../data/products';
import ProductActions from '../../components/react/ProductActions';
import { ChevronRight, Star, Heart, Share2, Truck, ShieldCheck, Plus } from 'lucide-react';

export async function getStaticPaths() {
  return allProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
---

<BaseLayout title={`${product.name} | Mithera Bakery`}>

  
  <main class="min-h-screen pb-20 pt-8 lg:pt-12 bg-white">
    <div class="container">
      
      {/* Breadcrumbs */}
      <nav class="flex items-center gap-2 font-body text-[12px] text-text-muted mb-8 lg:mb-12">
        <a href="/" class="hover:text-brand-dark transition-colors">Home</a>
        <ChevronRight className="w-3 h-3" />
        <a href="/shop" class="hover:text-brand-dark transition-colors">Shop</a>
        <ChevronRight className="w-3 h-3" />
        <a href="/shop" class="hover:text-brand-dark transition-colors">{product.category}</a>
        <ChevronRight className="w-3 h-3" />
        <span class="text-brand-dark font-medium">{product.name}</span>
      </nav>

      {/* Product Details Layout */}
      <div class="flex flex-col lg:flex-row gap-10 lg:gap-16">
        
        {/* Left: Image Gallery (Sticky) */}
        <div class="w-full lg:w-1/2 relative lg:sticky lg:top-24 h-max">
          <div class="w-full aspect-square bg-cream rounded-[16px] overflow-hidden relative group">
            {/* Action Buttons */}
            <div class="absolute top-4 right-4 flex flex-col gap-3 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <button class="w-[36px] h-[36px] bg-white rounded-full flex items-center justify-center text-text-secondary shadow-md transition-all duration-200 hover:bg-brand-warm hover:text-white hover:scale-110">
                <Heart className="w-[16px] h-[16px]" strokeWidth={2} />
              </button>
              <button class="w-[36px] h-[36px] bg-white rounded-full flex items-center justify-center text-text-secondary shadow-md transition-all duration-200 hover:bg-brand-dark hover:text-white hover:scale-110">
                <Share2 className="w-[16px] h-[16px]" strokeWidth={2} />
              </button>
            </div>
            {/* Main Image */}
            <img 
              src={product.image} 
              alt={product.name} 
              class="w-full h-full object-cover transition-transform duration-700 hover:scale-[1.03]"
            />
          </div>
        </div>

        {/* Right: Product Info */}
        <div class="w-full lg:w-1/2 flex flex-col reveal">
          
          <div class="mb-6">
            <span class="inline-block px-3 py-1 bg-cream-dark text-brand-dark font-body text-[11px] font-semibold tracking-wider uppercase rounded-full mb-4">
              {product.category}
            </span>
            <h1 class="font-heading text-[32px] lg:text-[42px] font-medium text-brand-dark leading-tight mb-2">
              {product.name}
            </h1>
            
            <div class="flex items-center gap-4 mb-4">
              <div class="flex items-center gap-1">
                {[1, 2, 3, 4, 5].map(() => (
                  <Star className="w-[14px] h-[14px] text-brand-gold fill-brand-gold" strokeWidth={1} />
                ))}
              </div>
              <span class="font-body text-[13px] text-text-secondary">
                <strong class="text-brand-dark">{product.rating}</strong> ({product.reviews} reviews)
              </span>
            </div>

            <p class="font-heading text-[28px] text-brand-warm font-medium">
              {product.price}
            </p>
            <p class="font-body text-[12px] text-text-muted mt-1">Inclusive of all taxes</p>
          </div>

          <div class="h-px w-full bg-brand-dark/10 my-6"></div>

          <div class="mb-8">
            <h3 class="font-body text-[15px] font-semibold text-brand-dark mb-3">About this item</h3>
            <p class="font-body text-[14px] text-text-secondary leading-relaxed">
              {product.description}
            </p>
          </div>

          {/* Size / Weight Selector (Mock) */}
          <div class="mb-8">
            <h3 class="font-body text-[14px] font-semibold text-brand-dark mb-3">Select Size / Weight</h3>
            <div class="flex flex-wrap gap-3">
              <button class="px-5 py-2.5 border-2 border-brand-dark text-brand-dark rounded-[8px] font-body text-[13px] font-semibold bg-white transition-colors">
                {product.weight}
              </button>
              {(product.category === 'Indian Sweets' || product.category === 'Gift Hampers') && (
                <button class="px-5 py-2.5 border border-brand-dark/20 text-text-secondary rounded-[8px] font-body text-[13px] hover:border-brand-dark transition-colors bg-white">
                  1 kg Box
                </button>
              )}
            </div>
          </div>

          {/* Actions: Qty + Cart + Buy */}
          <ProductActions client:load product={product} />

          {/* Trust Badges */}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-cream-light p-4 sm:p-5 rounded-[12px] border border-cream-dark/50 mb-8">
            <div class="flex items-start gap-3">
              <Truck className="w-5 h-5 text-brand-warm shrink-0 mt-0.5" strokeWidth={1.5} />
              <div>
                <strong class="block font-body text-[13px] text-brand-dark mb-0.5">Express Delivery</strong>
                <span class="font-body text-[12px] text-text-secondary">Same day delivery in Mumbai</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <ShieldCheck className="w-5 h-5 text-brand-warm shrink-0 mt-0.5" strokeWidth={1.5} />
              <div>
                <strong class="block font-body text-[13px] text-brand-dark mb-0.5">100% Pure</strong>
                <span class="font-body text-[12px] text-text-secondary">Made with premium ingredients</span>
              </div>
            </div>
          </div>

          {/* Accordions / Extra Details */}
          <div class="border-t border-brand-dark/10">
            <details class="group py-4 border-b border-brand-dark/10 cursor-pointer">
              <summary class="flex justify-between items-center font-body text-[14px] font-semibold text-brand-dark outline-none">
                Ingredients & Allergens
                <Plus className="w-4 h-4 transition-transform group-open:rotate-45" />
              </summary>
              <div class="pt-3 pb-1 font-body text-[13px] text-text-secondary">
                <ul class="list-disc pl-5 space-y-1">
                  {product.ingredients.map(ing => (
                    <li>{ing}</li>
                  ))}
                </ul>
                <p class="mt-3 text-[12px] text-text-muted italic">
                  Allergen Warning: Produced in a facility that also processes tree nuts, peanuts, and dairy.
                </p>
              </div>
            </details>
            
            <details class="group py-4 border-b border-brand-dark/10 cursor-pointer">
              <summary class="flex justify-between items-center font-body text-[14px] font-semibold text-brand-dark outline-none">
                Storage Instructions
                <Plus className="w-4 h-4 transition-transform group-open:rotate-45" />
              </summary>
              <div class="pt-3 pb-1 font-body text-[13px] text-text-secondary leading-relaxed">
                Store in a cool, dry place away from direct sunlight. Once opened, keep in an airtight container and consume within 3-4 days for optimal freshness. Do not refrigerate traditional Indian sweets unless specified.
              </div>
            </details>
          </div>

        </div>
      </div>
      
    </div>
  </main>
  
  <Footer />
</BaseLayout>

<script>
  // Intersection observer for scroll animations
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      root: null,
      rootMargin: "0px",
      threshold: 0.15
    });

    const revealElements = document.querySelectorAll('.reveal');
    revealElements.forEach(el => observer.observe(el));
  });
</script>
