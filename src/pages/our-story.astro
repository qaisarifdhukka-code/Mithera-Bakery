---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Our Story | Mithera Bakery & Patisserie">
  <main class="min-h-[70vh] bg-cream flex flex-col items-center justify-center py-20 px-4 text-center">
    <h1 class="font-heading text-[32px] lg:text-[48px] font-medium text-brand-dark mb-4">Our Story</h1>
    <p class="font-body text-text-secondary max-w-2xl mx-auto leading-relaxed">
      Coming Soon. Discover the rich history, traditional recipes, and modern craftsmanship that make Mithera Sweets unique.
    </p>
    <a href="/" class="mt-8 inline-flex items-center justify-center px-6 py-3 bg-brand-dark text-cream font-medium rounded-full hover:bg-brand-hover transition-colors">
      Return Home
    </a>
  </main>
  
  <Footer />
</BaseLayout>
