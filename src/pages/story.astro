---
import { sanityClient, urlFor } from '../lib/sanity';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { Leaf, HeartHandshake, Sparkles, ChefHat } from 'lucide-react';
import FaqSection from '../components/react/FaqSection';
import DescriptiveContent from '../components/DescriptiveContent.astro';

const storyData = await sanityClient.fetch(`*[_type == "storyPage"][0]`);

const defaultPhilosophies = [
  { title: 'Pure Ingredients', description: 'We source only the finest elements—authentic saffron, rich pure ghee, and premium nuts. Our commitment to quality means no artificial preservatives, just the genuine taste of nature.' },
  { title: 'Honoring Tradition', description: 'Every mithai we craft is a tribute to heritage. We follow age-old recipes meticulously, ensuring that every bite transports you to the nostalgic flavors of authentic Indian festivities.' },
  { title: 'Modern Elegance', description: 'While our roots are traditional, our presentation is distinctly modern. We believe that beautiful packaging and refined aesthetics elevate the entire experience of gifting and enjoying sweets.' }
];

const safeData = storyData || {
  heroTagline: "Our Heritage",
  heroHeading: "A Legacy of Sweetness",
  heroSubtext: "Mithera was born from a simple belief: the sweets we celebrate with should be as pure and joyous as the celebrations themselves. We blend generations of traditional recipes with the finest modern craftsmanship.",
  philosophiesTagline: "Guiding Principles",
  philosophiesHeading: "The Values We Live By",
  philosophies: defaultPhilosophies,
  artOfMithaiTagline: "Heritage Confectionery",
  artOfMithaiHeading: "The Art of Mithai",
  artOfMithaiText: "Creating the perfect Kaju Katli or a delicate Peda is an art form that requires patience, precision, and an intuitive understanding of flavors. Our master halwais bring decades of experience to the kitchen, treating every batch as a masterpiece.",
  artOfMithaiButtonText: "Explore Traditional Mithai",
  artOfMithaiButtonLink: "/shop?category=Indian+Sweets",
  frenchConnectionTagline: "Artisanal Patisserie",
  frenchConnectionHeading: "The French Connection",
  frenchConnectionText: "Alongside our traditional offerings, we embrace the meticulous world of patisserie. From perfectly laminated, buttery croissants to artisanal breads, our bakery items are crafted fresh every morning using classic French techniques.",
  frenchConnectionButtonText: "Discover Fresh Bakes",
  frenchConnectionButtonLink: "/shop?category=Bakery+Items",
  quoteText: "\"We don't just bake; we craft memories. Every box that leaves Mithera carries a piece of our heart and the warmth of a thousand celebrations.\"",
  quoteAttribution: "The Mithera Family · Mumbai"
};

const heroImageSrc = storyData?.heroImage ? urlFor(storyData.heroImage) : "/images/hero-image.png";
const artOfMithaiImageSrc = storyData?.artOfMithaiImage ? urlFor(storyData.artOfMithaiImage) : "/images/1 (6).png";
const frenchConnectionImageSrc = storyData?.frenchConnectionImage ? urlFor(storyData.frenchConnectionImage) : "/images/hero-image.png";

const rawHeading = safeData.heroHeading || "A Legacy of Sweetness";
const formattedHeading = rawHeading.includes('<span') 
  ? rawHeading 
  : rawHeading.replace(/Sweetness/i, "<br class='hidden sm:block'/><span class='italic font-normal text-brand-warm'>Sweetness</span>");

const cleanQuote = (safeData.quoteText || "")
  .replace(/^["“”\s]+|["“”\s]+$/g, '')
  .trim();

const philosophiesList = (safeData.philosophies && safeData.philosophies.length > 0)
  ? safeData.philosophies
  : defaultPhilosophies;

const philosophyIcons = [Leaf, HeartHandshake, Sparkles, ChefHat];
---

<BaseLayout 
  title={storyData?.seoTitle || "Our Story | Mithera Sweets & Bakery"}
  description={storyData?.seoDescription}
  schemaJson={storyData?.schemaJson}
>
  <main class="overflow-hidden bg-cream">
    
    {/* Editorial Hero with Custom Architectural Curved Silhouette */}
    <section class="bg-cream pt-10 pb-16 lg:py-20 border-b border-[#8C6A4A]/15">
      <div class="container relative z-10 px-4">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-10 lg:gap-14 max-w-6xl mx-auto">
          
          {/* Left Text Content */}
          <div class="w-full lg:w-1/2 reveal text-left">
            <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-brand-warm mb-3.5 block font-body">
              {safeData.heroTagline || "Our Heritage"}
            </span>
            <h1 class="font-heading text-[38px] sm:text-[48px] lg:text-[58px] leading-[1.08] font-normal text-brand-dark mb-5" set:html={formattedHeading}></h1>
            <p class="font-body text-[14px] sm:text-[15px] lg:text-[16px] text-text-secondary leading-[1.65] max-w-xl">
              {safeData.heroSubtext}
            </p>
          </div>
          
          {/* Right Custom Shaped Image with Luxury White Frame */}
          <div class="w-full lg:w-1/2 flex justify-center lg:justify-end reveal reveal-delay-2">
            <div class="w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[440px] aspect-[4/5] overflow-hidden rounded-tl-[80px] lg:rounded-tl-[100px] rounded-br-[80px] lg:rounded-br-[100px] rounded-tr-[20px] lg:rounded-tr-[24px] rounded-bl-0 border-[6px] sm:border-[8px] border-white shadow-[0_20px_40px_rgba(58,36,26,0.14)] bg-cream">
              <img 
                src={heroImageSrc} 
                alt="Mithera Artisan Sweets" 
                class="w-full h-full object-cover object-center transition-transform duration-700 hover:scale-105" 
                loading="eager"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* The Philosophy - Attractive Luxury Cards */}
    <section class="py-16 lg:py-24">
      <div class="container max-w-6xl mx-auto px-4">
        
        <div class="text-center mb-12">
          <span class="text-xs font-semibold tracking-[0.2em] uppercase text-brand-warm block mb-2 font-body">
            {safeData.philosophiesTagline || "Guiding Principles"}
          </span>
          <h2 class="font-heading text-[30px] lg:text-[40px] text-brand-dark font-medium">
            {safeData.philosophiesHeading || "The Values We Live By"}
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          {philosophiesList.map((item, index) => {
            const IconComponent = philosophyIcons[index % philosophyIcons.length];
            return (
              <div class={`bg-white rounded-2xl p-7 lg:p-8 border border-brand-warm/20 shadow-sm hover:shadow-md transition-all hover:-translate-y-1 reveal ${index > 0 ? `reveal-delay-${index}` : ''}`}>
                <div class="w-12 h-12 rounded-full bg-cream flex items-center justify-center mb-6 text-brand-dark">
                  <IconComponent className="w-6 h-6 text-brand-warm" strokeWidth={1.5} />
                </div>
                <h3 class="font-heading text-[22px] text-brand-dark mb-3 font-medium">{item?.title}</h3>
                <p class="font-body text-[14px] text-text-secondary leading-relaxed">
                  {item?.description}
                </p>
              </div>
            );
          })}
        </div>

      </div>
    </section>

    {/* The Dual Journey - Balanced Editorial Narrative */}
    <section class="py-16 lg:py-24 bg-cream border-t border-b border-brand-dark/10">
      <div class="container max-w-5xl mx-auto px-4">
        <div class="space-y-20 lg:space-y-28">
          
          {/* Block 1 - The Art of Mithai */}
          <div class="flex flex-col md:flex-row items-center gap-10 lg:gap-16">
            <div class="w-full md:w-1/2 order-2 md:order-1 reveal text-center md:text-left">
              <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-brand-warm block font-body mb-3">
                {safeData.artOfMithaiTagline || "Heritage Confectionery"}
              </span>
              <h2 class="font-heading text-[34px] sm:text-[42px] lg:text-[48px] text-brand-dark mb-5 leading-[1.15] font-normal sm:font-medium">
                {safeData.artOfMithaiHeading || "The Art of Mithai"}
              </h2>
              <p class="font-body text-[14px] sm:text-[15px] lg:text-[16px] text-text-secondary leading-[1.65] mb-6 max-w-lg mx-auto md:mx-0">
                {safeData.artOfMithaiText}
              </p>
              <div class="w-12 h-[1.5px] bg-[#8C6A4A]/60 mx-auto md:mx-0 mb-5"></div>
              <a 
                href={safeData.artOfMithaiButtonLink || "/shop?category=Indian+Sweets"} 
                class="inline-flex items-center text-[13px] font-semibold text-brand-dark hover:text-brand-warm transition-colors no-underline group"
              >
                {safeData.artOfMithaiButtonText || "Explore Traditional Mithai"} <span class="ml-1.5 transition-transform group-hover:translate-x-1">&rarr;</span>
              </a>
            </div>
            <div class="w-full md:w-1/2 order-1 md:order-2 reveal reveal-delay-1 flex justify-center md:justify-end">
              <div class="w-[300px] sm:w-[360px] lg:w-[420px] aspect-square overflow-hidden rounded-full border-[6px] sm:border-[8px] border-white shadow-[0_16px_36px_rgba(58,36,26,0.12)] bg-cream">
                <img 
                  src={artOfMithaiImageSrc} 
                  alt="Mithera Signature Sweets Assortment" 
                  class="w-full h-full object-cover object-center rounded-full transition-transform duration-700 hover:scale-105" 
                  loading="lazy"
                />
              </div>
            </div>
          </div>

          {/* Block 2 - The French Connection */}
          <div class="flex flex-col md:flex-row items-center gap-10 lg:gap-16">
            <div class="w-full md:w-1/2 reveal flex justify-center md:justify-start">
              <div class="w-[300px] sm:w-[360px] lg:w-[420px] aspect-square overflow-hidden rounded-[36px] lg:rounded-[44px] border-[6px] sm:border-[8px] border-white shadow-[0_16px_36px_rgba(58,36,26,0.12)] bg-cream">
                <img 
                  src={frenchConnectionImageSrc} 
                  alt="French Patisserie & Bakery Items" 
                  class="w-full h-full object-cover object-center rounded-[28px] lg:rounded-[36px] transition-transform duration-700 hover:scale-105" 
                  loading="lazy"
                />
              </div>
            </div>
            <div class="w-full md:w-1/2 reveal reveal-delay-1 text-center md:text-left">
              <span class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-brand-warm block font-body mb-3">
                {safeData.frenchConnectionTagline || "Artisanal Patisserie"}
              </span>
              <h2 class="font-heading text-[34px] sm:text-[42px] lg:text-[48px] text-brand-dark mb-5 leading-[1.15] font-normal sm:font-medium">
                {safeData.frenchConnectionHeading || "The French Connection"}
              </h2>
              <p class="font-body text-[14px] sm:text-[15px] lg:text-[16px] text-text-secondary leading-[1.65] mb-6 max-w-lg mx-auto md:mx-0">
                {safeData.frenchConnectionText}
              </p>
              <div class="w-12 h-[1.5px] bg-[#8C6A4A]/60 mx-auto md:mx-0 mb-5"></div>
              <a 
                href={safeData.frenchConnectionButtonLink || "/shop?category=Bakery+Items"} 
                class="inline-flex items-center text-[13px] font-semibold text-brand-dark hover:text-brand-warm transition-colors no-underline group"
              >
                {safeData.frenchConnectionButtonText || "Discover Fresh Bakes"} <span class="ml-1.5 transition-transform group-hover:translate-x-1">&rarr;</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Large Quote / Manifesto Section */}
    <section class="py-20 lg:py-28 relative bg-cream">
      <div class="container relative z-10 text-center max-w-4xl mx-auto px-4 reveal">
        <ChefHat className="w-10 h-10 text-brand-warm mx-auto mb-6 opacity-70" strokeWidth={1.2} />
        <blockquote class="font-heading text-[26px] sm:text-[36px] lg:text-[44px] leading-[1.32] text-brand-dark font-normal m-0 max-w-3xl mx-auto">
          <span class="font-serif text-brand-warm text-[44px] sm:text-[64px] lg:text-[80px] leading-none inline-block align-top mr-1 select-none -translate-y-1 sm:-translate-y-2">“</span>
          <span>{cleanQuote}</span>
          <span class="font-serif text-brand-warm text-[44px] sm:text-[64px] lg:text-[80px] leading-none inline-block align-bottom ml-1 select-none translate-y-1 sm:translate-y-2">”</span>
        </blockquote>
        <p class="font-body text-[11px] sm:text-[12px] font-semibold tracking-[0.25em] text-brand-warm uppercase mt-8">
          {safeData.quoteAttribution || "The Mithera Family · Mumbai"}
        </p>
      </div>
    </section>

    {/* Optional FAQs on Story */}
    {storyData?.faqs && storyData.faqs.length > 0 && (
      <FaqSection client:load data={{ tagline: 'Heritage Inquiries', title: 'Our Story & Methods FAQs', items: storyData.faqs }} />
    )}

    {/* Optional Descriptive Content */}
    {storyData?.descriptiveContent && (
      <DescriptiveContent data={{ content: storyData.descriptiveContent }} />
    )}

  </main>
  
  <Footer />
</BaseLayout>

<script>
  // Same intersection observer for scroll animations
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      root: null,
      rootMargin: "0px",
      threshold: 0.15
    });

    const revealElements = document.querySelectorAll('.reveal');
    revealElements.forEach(el => observer.observe(el));
  });
</script>

