---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { Leaf, HeartHandshake, Sparkles, ChefHat } from 'lucide-react';
---

<BaseLayout title="Our Story | Mithera Bakery & Patisserie">
<main class="overflow-hidden">
    {/* Minimal, Editorial Hero */}
    <section class="flex items-center min-h-[calc(100vh-80px)] pt-8 pb-12 lg:pt-0 lg:pb-0">
      <div class="container relative z-10">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-16">
          <div class="w-full lg:w-1/2 reveal text-center lg:text-left">
            <span class="section-label">Our Heritage</span>
            <h1 class="font-heading text-[42px] md:text-[56px] lg:text-[72px] leading-[1.05] font-medium text-brand-dark mt-3 mb-5">
              A Legacy of <br class="hidden lg:block"/>
              <span class="italic text-brand-warm">Sweetness</span>
            </h1>
            <p class="font-body text-[14px] lg:text-[16px] text-text-secondary leading-relaxed max-w-lg mx-auto lg:mx-0">
              Mithera was born from a simple belief: the sweets we celebrate with should be as pure and joyous as the celebrations themselves. We blend generations of traditional recipes with the finest modern craftsmanship.
            </p>
          </div>
          
          <div class="w-full lg:w-1/3 max-w-[340px] reveal reveal-delay-2 mx-auto lg:mx-0">
            <div class="aspect-[4/5] overflow-hidden rounded-tl-[60px] rounded-br-[60px] shadow-xl">
              <img src="/images/mobile.png" alt="Mithera Artisan Sweets" class="w-full h-full object-cover animate-slow-zoom" />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* The Philosophy - 3 Columns, Text heavy */}
    <section class="py-16 lg:py-24 border-t border-brand-dark/10">
      <div class="container">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
          <div class="reveal">
            <Leaf className="w-8 h-8 text-brand-accent mb-6" strokeWidth={1.5} />
            <h3 class="font-heading text-[24px] text-brand-dark mb-4">Pure Ingredients</h3>
            <p class="font-body text-[14px] text-text-secondary leading-relaxed">
              We source only the finest elements—authentic saffron, rich pure ghee, and premium nuts. Our commitment to quality means no artificial preservatives, just the genuine taste of nature.
            </p>
          </div>
          <div class="reveal reveal-delay-1">
            <HeartHandshake className="w-8 h-8 text-brand-accent mb-6" strokeWidth={1.5} />
            <h3 class="font-heading text-[24px] text-brand-dark mb-4">Honoring Tradition</h3>
            <p class="font-body text-[14px] text-text-secondary leading-relaxed">
              Every mithai we craft is a tribute to heritage. We follow age-old recipes meticulously, ensuring that every bite transports you to the nostalgic flavors of authentic Indian festivities.
            </p>
          </div>
          <div class="reveal reveal-delay-2">
            <Sparkles className="w-8 h-8 text-brand-accent mb-6" strokeWidth={1.5} />
            <h3 class="font-heading text-[24px] text-brand-dark mb-4">Modern Elegance</h3>
            <p class="font-body text-[14px] text-text-secondary leading-relaxed">
              While our roots are traditional, our presentation is distinctly modern. We believe that beautiful packaging and refined aesthetics elevate the entire experience of gifting and enjoying sweets.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* The Dual Journey - Alternating layout */}
    <section class="py-16 lg:py-24">
      <div class="container">
        <div class="max-w-4xl mx-auto space-y-24 lg:space-y-32">
          
          {/* Block 1 */}
          <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
            <div class="w-full md:w-1/2 order-2 md:order-1 reveal text-center md:text-left">
              <h2 class="font-heading text-[32px] lg:text-[40px] text-brand-dark mb-4 lg:mb-6">The Art of Mithai</h2>
              <p class="font-body text-[15px] text-text-secondary leading-relaxed mb-6">
                Creating the perfect Kaju Katli or a delicate Peda is an art form that requires patience, precision, and an intuitive understanding of flavors. Our master halwais bring decades of experience to the kitchen, treating every batch as a masterpiece.
              </p>
              <div class="w-12 h-[1px] bg-brand-warm mx-auto md:mx-0"></div>
            </div>
            <div class="w-full md:w-1/2 order-1 md:order-2 reveal reveal-delay-1">
              <div class="aspect-square overflow-hidden rounded-full shadow-[0_10px_40px_rgba(58,36,26,0.08)] p-2 bg-cream-off">
                <img src="/images/hero-image.png" alt="Indian Sweets" class="w-full h-full object-cover rounded-full" />
              </div>
            </div>
          </div>

          {/* Block 2 */}
          <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
            <div class="w-full md:w-1/2 reveal">
              <div class="aspect-square overflow-hidden rounded-[40px]">
                <img src="/images/mobile.png" alt="Bakery Items" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" />
              </div>
            </div>
            <div class="w-full md:w-1/2 reveal reveal-delay-1 text-center md:text-left">
              <h2 class="font-heading text-[32px] lg:text-[40px] text-brand-dark mb-4 lg:mb-6">The French Connection</h2>
              <p class="font-body text-[15px] text-text-secondary leading-relaxed mb-6">
                Alongside our traditional offerings, we embrace the meticulous world of patisserie. From perfectly laminated, buttery croissants to artisanal breads, our bakery items are crafted fresh every morning using classic French techniques.
              </p>
              <div class="w-12 h-[1px] bg-brand-warm mx-auto md:mx-0"></div>
            </div>
          </div>

        </div>
      </div>
    </section>

    {/* Large Quote / Manifesto Section */}
    <section class="py-20 lg:py-32 my-12 relative">
      <div class="absolute left-1/2 -translate-x-1/2 top-0 w-full max-w-5xl h-[1px] bg-gradient-to-r from-transparent via-brand-dark/20 to-transparent"></div>
      <div class="container relative z-10 text-center max-w-4xl mx-auto reveal">
        <ChefHat className="w-12 h-12 text-brand-accent mx-auto mb-8 opacity-50" strokeWidth={1} />
        <h2 class="font-heading text-[32px] md:text-[42px] lg:text-[52px] leading-[1.2] text-brand-dark font-medium">
          "We don't just bake; we craft memories. Every box that leaves Mithera carries a piece of our heart and the warmth of a thousand celebrations."
        </h2>
        <p class="font-body text-[13px] font-semibold tracking-[2px] text-brand-warm uppercase mt-10">
          The Mithera Family
        </p>
      </div>
      <div class="absolute left-1/2 -translate-x-1/2 bottom-0 w-full max-w-5xl h-[1px] bg-gradient-to-r from-transparent via-brand-dark/20 to-transparent"></div>
    </section>

  </main>
  
  <Footer />
</BaseLayout>

<script>
  // Same intersection observer for scroll animations
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      root: null,
      rootMargin: "0px",
      threshold: 0.15
    });

    const revealElements = document.querySelectorAll('.reveal');
    revealElements.forEach(el => observer.observe(el));
  });
</script>

